# Copy this file to .env for local development.
# In production (Render), you'll enter these same keys/values in the
# Render dashboard's Environment tab instead of using this file.

PORT=10000

# Supabase → Project Settings → Connect → "Session pooler" tab (NOT "Direct connection")
DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-your-region.pooler.supabase.com:5432/postgres

# GitHub → Settings → Developer settings → OAuth Apps → your app
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# Must exactly match the "Authorization callback URL" field in your GitHub OAuth App
GITHUB_CALLBACK_URL=https://vibemodded-index-api.onrender.com/auth/github/callback

# Scheme + host ONLY, no path — used for CORS. This must match what the
# browser sends as the Origin header when calling the API from GitHub Pages.
FRONTEND_ORIGIN=https://yourusername.github.io

# Full path to your deployed frontend — used for the post-login redirect.
FRONTEND_URL=https://yourusername.github.io/vibemodded-index

# Any long random string. Generate one with: openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_string
